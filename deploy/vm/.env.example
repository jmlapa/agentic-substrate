# ==============================================================================
# Agentic Substrate - Single-VM All-in-One Deployment Environment Configuration
# Copy this file to .env and adjust the values for your VM instance.
# DO NOT commit .env with real production secrets to version control.
# ==============================================================================

# General Environment
ENVIRONMENT=production
DEBUG=false
API_TITLE="Agentic Substrate API"
API_VERSION="0.1.0"

# Public Access & TLS Configuration (Caddy Reverse Proxy)
# Set DOMAIN_NAME to your domain (e.g. staging.yourdomain.com), localhost for local dev,
# or :80 for direct public IP access without TLS certificates in staging VMs.
# To protect staging with basic_auth, see deploy/vm/rules/auth.caddy.example.
DOMAIN_NAME=localhost
# ACME_EMAIL is used by Let's Encrypt for TLS expiry notifications.
ACME_EMAIL=admin@example.com

# LLM & Embeddings
# GEMINI_API_KEY: Required if EMBEDDING_SERVICE_TYPE=gemini
GEMINI_API_KEY=
EMBEDDING_SERVICE_TYPE=gemini # Options: memory | gemini
EMBEDDING_DIMENSION=768

# Google Cloud & Google Drive Connector (Service Account)
# Place your GCP Service Account JSON key on the VM disk under deploy/vm/credentials/ (e.g. google-service-account.json).
# It will be mounted read-only into the API container at /app/credentials/.
# Share the Google Drive folder with the Service Account email address as "Viewer" (Leitor).
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-service-account.json

# OpenRouter & Multimodal OCR
# OPENROUTER_API_KEY: Required for graph extraction, RAG synthesis, and visual OCR
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE="Agentic Substrate"
OPENROUTER_APP_REFERER=https://agentic-substrate.local
OPENROUTER_GRAPH_MODEL_NAME=meta-llama/llama-3.1-8b-instruct
OPENROUTER_SYNTHESIS_MODEL_NAME=google/gemma-4-26b-a4b-it
OPENROUTER_SYNTHESIS_MAX_TOKENS=800
OPENROUTER_MAX_RPM=1500
OPENROUTER_MAX_TPM=10000000
OPENROUTER_GRAPH_MAX_CONCURRENCY=50
OCR_VISION_MODEL_NAME=qwen/qwen3-vl-32b-instruct
OCR_MAX_CONCURRENCY=50
OCR_LOW_RES_SCALE=1.0
OCR_HIGH_RES_SCALE=2.0

# Event Sourcing & Relational Storage (PostgreSQL 16 + pgvector)
# Presets configured for internal Docker network communication
EVENT_STORE_TYPE=postgres # Options: memory | postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres # Change to a secure random password on production
POSTGRES_DB=agentic_substrate

# Graph Store (Unified FalkorDB / OpenCypher)
# Presets configured for internal Docker network communication
GRAPH_STORE_TYPE=falkordb # Options: memory | falkordb
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Redis & Job Queue (Persistent Sagas & Task Distribution)
# Presets configured for internal Docker network communication
JOB_QUEUE_TYPE=redis # Options: memory | redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage (Local File System mounted in VM)
STORAGE_TYPE=local
STORAGE_LOCAL_BASE_DIR=/app/data/storage
