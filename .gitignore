# ==============================================================================
# Agentic Substrate - Version Control Exclusions (.gitignore)
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
ENV/

# Testing, Coverage and Type Checking
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment Variables and Secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/

# IDEs and Editors
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Data, Storage and Container Volumes
data/
**/data/
postgres_data/
minio_data/
falkordb_data/
redis_data/
caddy_data/
caddy_config/
*.sqlite
*.sqlite3
*.db

# Frontend / Node.js
node_modules/
**/node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary and Scratch Files
tmp/
temp/
*.bak
*.orig
