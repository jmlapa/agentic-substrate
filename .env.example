# ==============================================================================
# Agentic Substrate - Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.
# DO NOT commit .env with real production secrets to version control.
# ==============================================================================

# General Environment
ENVIRONMENT=development
DEBUG=false
API_TITLE="Agentic Substrate API"
API_VERSION="0.1.0"

# LLM & Embeddings
# GEMINI_API_KEY: Required if EMBEDDING_SERVICE_TYPE=gemini or using PydanticAI graph extractor
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_MAX_RPM=300
GEMINI_MAX_TPM=1000000
GEMINI_MAX_CONCURRENCY=15
EMBEDDING_SERVICE_TYPE=memory # Options: memory | gemini
EMBEDDING_DIMENSION=768

# OpenRouter, Multimodal OCR & Graph Extraction
# OPENROUTER_API_KEY: Required if GRAPH_EXTRACTOR_PROVIDER=openrouter or enable_ocr is requested
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE="Agentic Substrate"
OPENROUTER_APP_REFERER=https://agentic-substrate.local
GRAPH_EXTRACTOR_PROVIDER=openrouter # Options: openrouter | gemini
OPENROUTER_GRAPH_MODEL_NAME=google/gemma-4-26b-a4b-it
OPENROUTER_SYNTHESIS_MODEL_NAME=google/gemma-4-26b-a4b-it
OPENROUTER_SYNTHESIS_MAX_TOKENS=800
OCR_VISION_MODEL_NAME=qwen/qwen3-vl-30b-a3b-instruct
OCR_MAX_CONCURRENCY=5
OCR_DEFAULT_MARKDOWN_PROMPT="Transcribe document faithfully into GitHub Flavored Markdown. Preserve tables, headings and lists, and provide descriptive text for figures and diagrams."

# Event Sourcing & Vector Storage (PostgreSQL + pgvector)
EVENT_STORE_TYPE=memory # Options: memory | postgres
VECTOR_STORE_TYPE=memory # Options: memory | pgvector
# DATABASE_URL: Optional override. If unset, uses POSTGRES_* granular settings below
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_substrate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_substrate

# Graph Store (FalkorDB / OpenCypher)
GRAPH_STORE_TYPE=memory # Options: memory | falkordb
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=

# Object Storage (Local File System or S3)
STORAGE_TYPE=local # Options: local | s3
STORAGE_LOCAL_BASE_DIR=./data/storage
S3_BUCKET_NAME=agentic-substrate-storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
