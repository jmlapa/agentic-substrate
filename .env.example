# ==============================================================================
# Agentic Substrate - Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.
# DO NOT commit .env with real production secrets to version control.
# ==============================================================================

# General Environment
ENVIRONMENT=development
DEBUG=false
API_TITLE="Agentic Substrate API"
API_VERSION="0.1.0"

# LLM & Embeddings
# GEMINI_API_KEY: Required if EMBEDDING_SERVICE_TYPE=gemini
GEMINI_API_KEY=
EMBEDDING_SERVICE_TYPE=memory # Options: memory | gemini
EMBEDDING_DIMENSION=768

# Google Cloud & Google Drive Connector (Service Account)
# Path to GCP Service Account JSON key on disk for Google Drive folder sync.
# In local dev: ./secrets/google_application_credentials.json (secrets/ mounted to /app/secrets)
# In VM deploy: /app/credentials/google-service-account.json (mounted from deploy/vm/credentials/)
# Remember to share target Drive folders with the service account email as Viewer.
GOOGLE_APPLICATION_CREDENTIALS=

# OpenRouter & Multimodal OCR
# OPENROUTER_API_KEY: Required for graph extraction, RAG synthesis, and visual OCR
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE="Agentic Substrate"
OPENROUTER_APP_REFERER=https://agentic-substrate.local
OPENROUTER_GRAPH_MODEL_NAME=meta-llama/llama-3.1-8b-instruct
OPENROUTER_SYNTHESIS_MODEL_NAME=google/gemma-4-26b-a4b-it
OPENROUTER_SYNTHESIS_MAX_TOKENS=800
OPENROUTER_MAX_RPM=1500
OPENROUTER_MAX_TPM=10000000
OPENROUTER_GRAPH_MAX_CONCURRENCY=50
OCR_VISION_MODEL_NAME=qwen/qwen3-vl-32b-instruct
OCR_MAX_CONCURRENCY=50
OCR_LOW_RES_SCALE=1.0
OCR_HIGH_RES_SCALE=2.0

# Event Sourcing & Relational Storage (PostgreSQL 16 + pgvector)
EVENT_STORE_TYPE=memory # Options: memory | postgres
# DATABASE_URL: Optional override. If unset, uses POSTGRES_* granular settings below
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_substrate
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_substrate

# Graph Store (FalkorDB / OpenCypher)
GRAPH_STORE_TYPE=memory # Options: memory | falkordb
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=

# Redis & Job Queue (Persistent Sagas & Task Distribution)
JOB_QUEUE_TYPE=memory # Options: memory | redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage (Local File System)
STORAGE_LOCAL_BASE_DIR=./data/storage
